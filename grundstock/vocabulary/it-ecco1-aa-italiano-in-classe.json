 "entries": [
  {
   "id": "aa-italiano-in-classe-001",
   "target": "Puoi aiutarmi?",
   "translations": [
    "Kannst du mir helfen?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-002",
   "target": "Posso aiutarti?",
   "translations": [
    "Kann ich dir helfen?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-003",
   "target": "Mi aiuti?",
   "translations": [
    "Hilfst du mir?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-004",
   "target": "Hai una penna / una matita?",
   "translations": [
    "Hast du einen Stift?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-005",
   "target": "Può ripetere, per favore?",
   "translations": [
    "Können Sie das bitte wiederholen?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-006",
   "target": "Può spiegarlo ancora una volta?",
   "translations": [
    "Können Sie das noch einmal erklären?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-007",
   "target": "Non capisco.",
   "translations": [
    "Ich verstehe das nicht."
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-008",
   "target": "Non ho capito.",
   "translations": [
    "Ich habe das nicht verstanden."
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-009",
   "target": "Può parlare più lentamente, per favore?",
   "translations": [
    "Können Sie bitte langsamer sprechen?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-010",
   "target": "Può spiegare … ?",
   "translations": [
    "Könnten Sie … erklären?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-011",
   "target": "Ho una domanda.",
   "translations": [
    "Ich habe eine Frage."
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-012",
   "target": "Come, scusi?",
   "translations": [
    "Wie bitte?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-013",
   "target": "Che cos’è questo?",
   "translations": [
    "Was ist das?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-014",
   "target": "Non ho capito l’esercizio.",
   "translations": [
    "Ich habe die Aufgabe nicht verstanden."
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-015",
   "target": "Non capisco la parola / la frase …",
   "translations": [
    "Ich verstehe das Wort / den Satz … nicht."
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-016",
   "target": "Che cosa significa … in tedesco?",
   "translations": [
    "Was bedeutet … auf Deutsch?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-017",
   "target": "Come si dice … in italiano?",
   "translations": [
    "Was heißt … auf Italienisch?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-018",
   "target": "Si può dire anche … ?",
   "translations": [
    "Kann man auch … sagen?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-019",
   "target": "Come si scrive … ?",
   "translations": [
    "Wie schreibt man …?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-020",
   "target": "… si scrive con o senza “h”?",
   "translations": [
    "Schreibt man … mit oder ohne „h“?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-021",
   "target": "Come si pronuncia … ?",
   "translations": [
    "Wie spricht man … aus?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-022",
   "target": "Può fare un esempio, per favore?",
   "translations": [
    "Können Sie bitte ein Beispiel nennen?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-023",
   "target": "A che pagina?",
   "translations": [
    "Auf welcher Seite?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-024",
   "target": "È giusto/corretto?",
   "translations": [
    "Ist das richtig?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-025",
   "target": "È sbagliato?",
   "translations": [
    "Ist das falsch?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-026",
   "target": "Quanto tempo abbiamo?",
   "translations": [
    "Wie viel Zeit haben wir?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-027",
   "target": "Che cosa facciamo adesso?",
   "translations": [
    "Was machen wir jetzt?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-028",
   "target": "Vado avanti io?",
   "translations": [
    "Soll ich weitermachen?"
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-029",
   "target": "Cominciamo dall’inizio.",
   "translations": [
    "Wir fangen von vorne an."
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-030",
   "target": "Adesso tocca a te e dopo tocca a lui/lei.",
   "translations": [
    "Jetzt bist du dran, danach ist er/sie dran."
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-031",
   "target": "Mi scusi, non l’ho fatto apposta.",
   "translations": [
    "Tut mir leid, das habe ich nicht mit Absicht getan."
   ],
   "page": "161-162"
  },
  {
   "id": "aa-italiano-in-classe-032",
   "target": "Mi scusi, (non) è colpa mia.",
   "translations": [
    "Tut mir leid, das ist (nicht) meine Schuld."
   ],
   "page": "161-162",
   "acceptedAnswers": [
    "Mi scusi, è colpa mia."
   ]
  },
  {
   "id": "aa-italiano-in-classe-033",
   "target": "Scusami. / Scusa.",
   "translations": [
    "Entschuldige."
   ],
   "page": "161-162"
  }
 ],
